# OpenAI API Key (required for real-time Whisper transcription & GPT evaluation)
# If omitted or left empty, the application runs in resilient demo/mock mode.
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1

# Server & Network Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & Safeguards
MAX_AUDIO_UPLOAD_SIZE_MB=25
